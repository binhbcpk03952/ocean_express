# ==========================================================================
# OCEAN EXPRESS — Frontend env (mẫu). COPY sang .env rồi điền giá trị thật.
# File .env KHÔNG được commit (đã ignore). File .example này thì commit được.
#
# LƯU Ý BẢO MẬT QUAN TRỌNG: mọi biến VITE_* đều bị NHÚNG vào bundle JS gửi
# xuống browser -> KHÔNG bí mật tuyệt đối. Với map key (Google/Goong), phải
# giới hạn theo HTTP referrer/domain trong dashboard nhà cung cấp; .env chỉ
# giúp tách cấu hình khỏi code, KHÔNG giấu được key khỏi client.
# ==========================================================================

# URL gốc của API backend.
VITE_API_BASE_URL=http://localhost:8081/api/v1

# Nhà cung cấp bản đồ: geojson (tự chủ, mặc định) | goong | google
VITE_MAP_PROVIDER=geojson

# Map key — chỉ cần khi VITE_MAP_PROVIDER là goong hoặc google.
# Để trống nếu dùng geojson tự chủ.
VITE_GOONG_MAPTILES_KEY=
VITE_GOOGLE_MAPS_KEY=
